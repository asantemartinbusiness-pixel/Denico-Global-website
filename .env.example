# Copy to .env.local for local work. Never commit real values.

# Public origin used for canonical URLs, sitemap and Open Graph.
# Confirm the production domain before launch.
NEXT_PUBLIC_SITE_URL=https://denicoglobal.com

# "production" allows indexing. Any other value (default) emits
# noindex headers and a disallow-all robots.txt.
SITE_ENV=development

# Shows provenance tags on every content block (for content review).
NEXT_PUBLIC_REVIEW_MODE=0

# Enquiry delivery: "outbox" (local JSON files in .outbox/, never sends),
# "webhook" (POST to ENQUIRY_WEBHOOK_URL), or "disabled".
# Default: outbox in development, disabled in production.
ENQUIRY_DELIVERY_MODE=outbox
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Rate limiting. Set ENQUIRY_CLIENT_IP_HEADER to a header your hosting platform
# overwrites with the real client IP (e.g. cf-connecting-ip). If unset, all
# visitors share one global bucket. X-Forwarded-For is never trusted.
ENQUIRY_CLIENT_IP_HEADER=
ENQUIRY_RATE_LIMIT=5
ENQUIRY_GLOBAL_RATE_LIMIT=30

# Recipient routing. Source-observed values; confirm before production.
ENQUIRY_TO_GENERAL=info@denicoglobal.com
ENQUIRY_TO_PRESS=press@denicoglobal.com
ENQUIRY_TO_STUDIOS=studio@denicoglobal.com
